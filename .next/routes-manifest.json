      "page": "/operations/customers/[id]",
      "regex": "^/operations/customers/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/operations/customers/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/operations/installations/[id]",
